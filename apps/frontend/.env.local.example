NEXT_PUBLIC_API_URL=http://localhost:3001

# Cloudflare Turnstile site key — renders the captcha widget required from the
# 3rd failed login attempt onward. Cloudflare's official "always passes" test
# site key (safe for local dev — must match the backend's test secret key).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
