DB_HOST=localhost
DB_PORT=5499
DB_USER=postgres
DB_PASS=postgres
DB_NAME=app
DB_SCHEMA=dev
REDIS_HOST=localhost
REDIS_PORT=6399
JWT_SECRET=local-dev-jwt-secret-change-in-production
JWT_EXPIRATION=900s
JWT_REFRESH_EXPIRATION=7d
FRONTEND_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@pulso.center

# Optional: fill in to upload files to S3 instead of the local disk fallback (uploads/).
# Requires valid AWS credentials locally too (aws configure/sso login --profile umi-homologation).
# The SDK uses its default credential chain, not a custom env var read by this app.
# Staging bucket (infra/terraform/environments/staging), safe to reuse for local dev:
AWS_S3_BUCKET=clinic-assets-staging
AWS_REGION=us-east-1
