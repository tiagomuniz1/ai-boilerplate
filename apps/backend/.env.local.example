DB_HOST=localhost
DB_PORT=5499
DB_USER=postgres
DB_PASS=postgres
DB_NAME=app
DB_SCHEMA=dev
REDIS_HOST=localhost
REDIS_PORT=6399
JWT_SECRET=local-dev-jwt-secret-change-in-production
JWT_EXPIRATION=900s
JWT_REFRESH_EXPIRATION=7d
FRONTEND_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@pulso.center

# Cloudflare Turnstile secret key — verifies the captcha token required from the
# 3rd failed login attempt onward. Left unset in local dev: the adapter falls
# back to Cloudflare's official "always passes" test secret automatically.
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: fill in to upload files to S3 instead of the local disk fallback (uploads/).
# Requires valid AWS credentials locally too (aws configure/sso login --profile pulso-workload).
# The SDK uses its default credential chain, not a custom env var read by this app.
# Production bucket (infra/terraform/environments/production) — only point local dev
# at it deliberately (it holds real clinic assets); the disk fallback is the default
# for a reason.
# AWS_S3_BUCKET=clinic-assets-production
# AWS_REGION=us-east-1
